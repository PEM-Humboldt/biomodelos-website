<h1 class="tasks"><%= t('biomodelos.groups.profile.tasks_tab') %></h1> 
<% if @current_group_user %>
	<div class="newtask" ng-click="taskbox=!taskbox" rel="tooltip" title="<%= t('biomodelos.tasks.new_task') %>"><%= inline_svg_tag("icons/newtask.svg", class: "icon icon-newtask", aria_hidden: true) %></div>
	<div class="clearfix"></div>
	<div class="addtask" ng-show="taskbox">
		<%= render partial:'tasks/new_tasks_form', locals: {task: @task, group: @group, group_members: @group_members, group_species: @group_species, current_group_user: @current_group_user} %>	
	</div>
<% end %>
<div class="clearfix"></div>
<div class="colspp tabletit">
	<h2><%= t('biomodelos.tasks.species') %></h2>
</div><!-- 
--><div class="coladv tabletit" rel="tooltip" title="<%= t('biomodelos.tasks.records_task_tt') %>">
	<%= inline_svg_tag("icons/regperfil.svg", class: "icon icon-tablehead", aria_hidden: true) %>
</div><!-- 
--><div class="coladv tabletit" rel="tooltip" title="<%= t('biomodelos.tasks.edition_task_tt') %>">
	<%= inline_svg_tag("icons/penperfil.svg", class: "icon icon-tablehead", aria_hidden: true) %>
</div><!--  
--><div class="coladv tabletit" rel="tooltip" title="<%= t('biomodelos.tasks.covers_task_tt') %>">
	<%= inline_svg_tag("icons/veicon.svg", class: "icon icon-tablehead", aria_hidden: true) %>
</div><!-- 
--><div class="coladv tabletit" rel="tooltip" title="<%= t('biomodelos.tasks.validation_task_tt') %>">
	<%= inline_svg_tag("icons/aprobicon.svg", class: "icon icon-tablehead", aria_hidden: true) %>
</div><!-- 
--><div class="coladv tabletit" rel="tooltip" title="<%= t('biomodelos.tasks.advance_tt') %>">
	<%= inline_svg_tag("icons/percicon.svg", class: "icon icon-tablehead", aria_hidden: true) %>
</div>
<div id="group_tasks_table"></div>
