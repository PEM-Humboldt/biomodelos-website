						<% tasks_done = tasks_done + 1 %>
				<% else %>
					<% if user_signed_in? && task[0].user_id == current_user.id %>
						<%= check_box_tag "task_active_#{task[0].id}",  task[0].id %>
					<% else %>
						<span class="icon-wrap" title="<%= t('biomodelos.tasks.developing_tt') %>" rel="tooltip"><%= inline_svg_tag("icons/develop.svg", class: "icon icon-task icon-develop", aria_hidden: true) %></span>
					<% end %>
				<% end %>
			<% else %>
					<span class="icon-wrap" title="<%= t('biomodelos.tasks.not_assigned_tt') %>" rel="tooltip"><%= inline_svg_tag("icons/notask.svg", class: "icon icon-task icon-notask", aria_hidden: true) %></span>
			<% end %>
		</div><!--
		--><div class="coladv"><% task = @tasks.select{|x| x.task_type_id == 4 && x.species_id == species[1]}.uniq %>
			<% if task.size > 0 %>
				<% total_tasks = total_tasks + 1 %>
